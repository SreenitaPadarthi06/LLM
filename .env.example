# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Required: your OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here


# Optional: model used for intent classification (fast, cheap)
MODEL_CLASSIFIER=gpt-4o-mini

# Optional: model used to generate the final expert response
MODEL_RESPONDER=gpt-4o-mini

# Optional: confidence threshold (0.0 – 1.0).
# Intents with confidence BELOW this value are treated as 'unclear'.
CONFIDENCE_THRESHOLD=0.7

# Optional: API timeouts in seconds to avoid hanging requests.
CLASSIFIER_TIMEOUT_SEC=20
RESPONDER_TIMEOUT_SEC=45

# Optional: path to the JSON Lines log file
# Default: route_log.jsonl  (project root)
# Docker:  /app/logs/route_log.jsonl
LOG_FILE=route_log.jsonl
